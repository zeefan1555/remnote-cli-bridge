{
  "manifestVersion": 1,
  "id": "zeefan-remnote-sdk-bridge",
  "name": "RemNote SDK Bridge",
  "author": "zeefan1555",
  "description": "Authenticated local access to the official RemNote Plugin SDK for remnote-cli.",
  "version": {
    "major": 0,
    "minor": 24,
    "patch": 0
  },
  "repoUrl": "https://github.com/zeefan1555/remnote-direct",
  "enableOnMobile": false,
  "requestNative": false,
  "requiredScopes": [
    {
      "type": "All",
      "level": "ReadCreateModifyDelete"
    },
    {
      "type": "KnowledgeBaseInfo",
      "level": "Read"
    }
  ]
}
